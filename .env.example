# Account Garmin Connect
GARMIN_EMAIL=la-tua-email@esempio.com
# GARMIN_PASSWORD=   # Opzionale (consigliato lasciare vuoto: viene chiesta al primo login nel terminale)

# Modalità demo (1 = usa dati sintetici senza contattare Garmin, 0 = usa dati reali)
DEMO_MODE=1

# Percorsi locali (opzionali, hanno già questi valori di default)
# DB_PATH=data/garmin.db
# TOKEN_DIR=data/tokens
